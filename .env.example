# SkillForge AI — Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file.

# Database (Prisma datasource — pooled connection for app runtime)
DATABASE_URL=your_supabase_pooled_connection_string_here

# Direct connection — required for running migrations only (not app runtime)
DIRECT_URL=your_supabase_direct_connection_string_here

# Authentication
JWT_SECRET=your_random_secret_here_min_32_chars
JWT_EXPIRES_IN=30m

# Server
PORT=3001
FRONTEND_URL=http://localhost:5173
NODE_ENV=development

# LLM Provider (used server-side only — NEVER expose to frontend)
LLM_API_KEY=your_api_key_here

# Supabase (for object storage & optional hosted Postgres)
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Session / cookie signing (if using session-based auth instead of JWT)
SESSION_SECRET=your_random_session_secret_here
