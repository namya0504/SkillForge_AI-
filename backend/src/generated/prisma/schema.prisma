generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String         @id @default(uuid())
  email            String         @unique
  passwordHash     String         @map("password_hash")
  targetRoleId     String?        @map("target_role_id")
  customTargetRole String?        @map("custom_target_role")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  resumes          Resume[]
  skills           Skill[]
  jobs             Job[]
  roadmap          Roadmap?
  targetRole       RoleReference? @relation(fields: [targetRoleId], references: [id], onDelete: SetNull)

  @@map("users")
}

model RoleReference {
  id             String   @id @default(uuid())
  title          String   @unique
  category       String   @default("Software Development")
  isPopular      Boolean  @default(false) @map("is_popular")
  description    String?
  requiredSkills String   @map("required_skills") // JSON string array of required skills with baseline proficiencies
  createdAt      DateTime @default(now()) @map("created_at")
  users          User[]

  @@map("roles_reference")
}

model Resume {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  storageKey   String   @map("storage_key")
  originalName String   @map("original_name")
  mimeType     String   @map("mime_type")
  fileSize     Int      @map("file_size")
  parsedStatus String   @default("pending") @map("parsed_status")
  parsedData   String?  @map("parsed_data")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("resumes")
}

model Skill {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  skillName   String   @map("skill_name")
  proficiency String   @default("Beginner")
  source      String   @default("manual")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skillName])
  @@map("skills")
}

model Job {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  type        String
  status      String    @default("pending")
  payload     String?
  result      String?
  errorMsg    String?   @map("error_msg")
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("jobs")
}

model Roadmap {
  id              String   @id @default(uuid())
  userId          String   @unique @map("user_id")
  targetRoleTitle String   @map("target_role_title")
  gapAnalysis     String   @map("gap_analysis") // JSON string: { matchedSkills, missingSkills, levelGaps }
  milestones      String // JSON string array of learning phases
  recommendations String // JSON string object: { projects, certifications }
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("roadmaps")
}
