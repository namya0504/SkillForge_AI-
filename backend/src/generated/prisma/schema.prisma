generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  passwordHash     String    @map("password_hash")
  isEmailVerified  Boolean   @default(false) @map("is_email_verified")
  emailVerifiedAt  DateTime? @map("email_verified_at")
  targetRoleId     String?   @map("target_role_id")
  customTargetRole String?   @map("custom_target_role")
  interests        String[]  @default([])
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  resumes               Resume[]
  skills                Skill[]
  jobs                  Job[]
  progress              Progress[]
  roadmap               Roadmap?
  chatSessions          ChatSession[]
  certificationProgress CertificationProgress[]
  targetRole            RoleReference?          @relation(fields: [targetRoleId], references: [id], onDelete: SetNull)

  @@map("users")
}

model RoleReference {
  id               String   @id @default(uuid())
  title            String   @unique
  category         String   @default("Software Development")
  isPopular        Boolean  @default(false) @map("is_popular")
  description      String?
  requiredSkills   String   @map("required_skills") // JSON string array
  capstoneProjects String?  @map("capstone_projects") // JSON string array of curated templates
  createdAt        DateTime @default(now()) @map("created_at")
  users            User[]

  @@index([isPopular])
  @@map("roles_reference")
}

model Resume {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  storageKey   String   @map("storage_key")
  originalName String   @map("original_name")
  mimeType     String   @map("mime_type")
  fileSize     Int      @map("file_size")
  parsedStatus String   @default("pending") @map("parsed_status")
  parsedData   String?  @map("parsed_data")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("resumes")
}

model Skill {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  skillName   String   @map("skill_name")
  proficiency String   @default("Beginner")
  source      String   @default("manual")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skillName])
  @@index([userId])
  @@map("skills")
}

model Job {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  type        String
  status      String    @default("pending")
  payload     String?
  result      String?
  errorMsg    String?   @map("error_msg")
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status, createdAt])
  @@map("jobs")
}

model Progress {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  itemId    String   @map("item_id")
  status    String   @default("not_started") // not_started | in_progress | completed
  updatedAt DateTime @updatedAt @map("updated_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId])
  @@map("progress")
}

model Roadmap {
  id               String   @id @default(uuid())
  userId           String   @unique @map("user_id")
  targetRoleTitle  String   @map("target_role_title")
  gapAnalysis      String   @map("gap_analysis") // JSON string: { matchedSkills, missingSkills, levelGaps }
  milestones       String // JSON string array of learning phases
  recommendations  String // JSON string object: { projects, certifications }
  selectedCapstone String?  @map("selected_capstone") // JSON string object of chosen capstone
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("roadmaps")
}

model ChatSession {
  id        String        @id @default(uuid())
  userId    String        @map("user_id")
  title     String?       @default("Career Mentor Chat")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([userId])
  @@map("chat_sessions")
}

model ChatMessage {
  id          String      @id @default(uuid())
  sessionId   String      @map("session_id")
  role        String // 'user' | 'assistant'
  content     String
  intent      String?     @default("personal") // 'personal' | 'general' | 'hybrid'
  contextUsed String?     @map("context_used") // JSON string snapshot of injected profile data
  citations   String? // JSON string array of { title, url, snippet } from search grounding
  createdAt   DateTime    @default(now()) @map("created_at")
  session     ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("chat_messages")
}

model CertificationProgress {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  certIdentifier String   @map("cert_identifier") // Title or slug matching curated database
  status         String   @default("recommended") // 'recommended' | 'in_progress' | 'completed'
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, certIdentifier])
  @@index([userId])
  @@map("certification_progress")
}
